# TMDb configuration (server-only).
# Use your TMDb API Read Access Token, not your API key.
# Never expose the token to the client or commit real credentials.
NUXT_TMDB_API_READ_ACCESS_TOKEN=[YOUR-TMDB-API-TOKEN]

# TMDb API base URL.
NUXT_TMDB_BASE_URL=https://api.themoviedb.org/3

# LLM configuration (server-only).
# Not yet read by the application (missing from runtimeConfig and the LLM client).
# Only local model servers without authentication work at the moment.
NUXT_LLM_API_KEY=

# LLM provider used by the application.
NUXT_LLM_PROVIDER=lmstudio

# Base URL of the local model server's OpenAI-compatible API.
NUXT_LLM_BASE_URL=http://localhost:1234/v1

# Model identifier exposed by your model server.
# Replace this example with the identifier of your available model.
NUXT_LLM_MODEL=google_gemma-4-26b-a4b-it

# Reasoning effort sent as reasoning_effort: none, minimal, low, medium, high, xhigh or max.
# Leave empty to send nothing (provider default). Reasoning models such as Gemma 4 in
# LM Studio need "none": otherwise reasoning uses up the output budget and no proposal arrives.
NUXT_LLM_REASONING=none

# Default application locale. Not yet read by the application.
NUXT_APP_DEFAULT_LOCALE=en